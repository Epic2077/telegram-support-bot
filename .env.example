# Telegram
MOTHER_BOT_TOKEN=your_mother_bot_token_from_botfather
OWNER_TELEGRAM_CHAT_ID=your_personal_telegram_chat_id
OWNER_PASSWORD=your_secure_password
OWNER_USERNAME=your_telegram_username
APPROVAL_CHANNEL_ID=-1001234567890
ADMIN_CHANNEL_ID=-1001234567891

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# System OpenAI Key (for embeddings - fallback when tenants don't have their own)
SYSTEM_OPENAI_KEY=your_openai_api_key

# Server
PORT=3000
WEBHOOK_DOMAIN=your_domain.com

# Liara AI (OpenAI-compatible custom endpoint)
AI_LIARA_BASE_URL=https://ai.liara.ir/api/6abe8dfc7ce6d9a9e0475844/v1
AI_LIARA_MODEL=gpt-4o-mini

# Rate Limiting (per-tenant, per-minute)
RATE_LIMIT_MAX_REQUESTS=30

# Scraper Tuning
SCRAPER_MAX_PAGES=500
SCRAPER_CONCURRENCY=5
SCRAPER_DELAY_MS=100